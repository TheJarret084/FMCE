<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hudSkin>
<!--
    Notas de Funky Maker: Mobile (fmm.png/xml originales).
    Solo trae las flechas y el sustain (tail / tailEnd), asi que el receptor y el confirm reusan
    el frame de la flecha. El atlas es a escala de grises: se tiñe con un solo color (type="tint").
-->
<hudSkin type="tint" name="Funky Maker: Mobile" author="KingGC" version="1.1">
    <atlas path="notes/default" scale="0.8"/> <!-- script en data/hudSkin.hx: le pone una sombra (dropShadow) a notas y receptores -->

    <!-- Toda la configuracion visual del HUD. El TEXTO lo ponen las traducciones. -->
    <assets font="milky.ttf" scoreDir="score"/>

    <countdown ready="ready" set="set" go="go" scale="1" alpha="1"/>

    <!-- Tipo de barra de tiempo (ya no esta en Opciones): mode="legacy" usa empty/fill de aca; mode="allowColor" usa el color de la barra de vida.
         style: pinklime | mono | multi (solo aplica con mode="legacy"). -->
    <timeBar mode="legacy" style="multi" width="400" height="18" bgPad="4"
             empty="0xFF101016" fill="0xFFFF8AFF" border="0xFF000000" textColor="0xFFFFFFFF"/>

    <texts>
        <text id="score"     size="20" color="0xFFFFFFFF" border="0xFF000000" borderSize="1.25" align="right"  alpha="1"/>
        <text id="misses"    size="20" color="0xFFFFFFFF" border="0xFF000000" borderSize="1.25" align="center" alpha="1"/>
        <text id="accuracy"  size="20" color="0xFFFFFFFF" border="0xFF000000" borderSize="1.25" align="left"   alpha="1"/>
        <text id="time"      size="32" color="0xFFFFFFFF" border="0xFF000000" borderSize="2"    align="center" alpha="1"/>
        <text id="rating"    size="64" color="0xFFFFFFFF" border="0xFF000000" borderSize="3"    align="center" alpha="1"/>
        <text id="combo"     size="64" color="0xFFFFFFFF" border="0xFF000000" borderSize="3"    align="center" alpha="1"/>
        <text id="press"     size="22" color="0xFF5CF0DC" border="0xFF000000" borderSize="1.5"  align="center" alpha="1"/>
        <text id="botplay"   size="32" color="0xFFFFFFFF" border="0xFF000000" borderSize="2"    align="center" alpha="1"/>
    </texts>

    <holdAlpha value="0.7"/>

    <!-- El receptor / confirm crece a esta escala al apretar y vuelve a la base al soltar (tint: 1.15 por defecto). -->
    <pressedScale value="1.15"/>

    <!-- Splash en imagen aparte (NOTE_splashes.png/xml): una sola animacion "splash" (4 frames de 700x700) para todas las lanes, se tiñe con el color de la lane.
         scale 0.6 porque sus frames son enormes frente a la flecha (160px). -->
    <splash atlas="splashes/default" scale="0.6" alpha="0.85" fps="20"/>

    <animations>
        <lane dir="left"  note="left"  hold="tail0" holdEnd="tailEnd" receptor="left"  press="left"  confirm="left" splash="splash"/>
        <lane dir="down"  note="down"  hold="tail0" holdEnd="tailEnd" receptor="down"  press="down"  confirm="down" splash="splash"/>
        <lane dir="up"    note="up"    hold="tail0" holdEnd="tailEnd" receptor="up"    press="up"    confirm="up" splash="splash"/>
        <lane dir="right" note="right" hold="tail0" holdEnd="tailEnd" receptor="right" press="right" confirm="right" splash="splash"/>
    </animations>
</hudSkin>
