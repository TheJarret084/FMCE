<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hudSkin>
<!--
    Notas de Codename Engine (assets/images/game/notes/default.png/xml originales).
    type="sparrow": el atlas ya viene pintado (notas de colores, colas, receptores), asi que se dibuja tal cual.
-->
<hudSkin type="sparrow" name="Codename" author="Codename Crew" version="1.0">
    <atlas path="notes/default"/>

    <!-- Toda la configuracion visual del HUD. El TEXTO lo ponen las traducciones. -->
    <assets font="vcr.ttf" scoreDir="score"/>

    <countdown ready="ready" set="set" go="go" scale="1" alpha="1"/>

    <timeBar mode="legacy" style="mono" width="400" height="18" bgPad="4"
             empty="0xFF101016" fill="0xFFFF8AFF" border="0xFF000000" textColor="0xFFFFFFFF"/>

    <texts>
        <text id="score"     size="20" color="0xFFFFFFFF" border="0xFF000000" borderSize="1.25" align="right"  alpha="1"/>
        <text id="misses"    size="20" color="0xFFFFFFFF" border="0xFF000000" borderSize="1.25" align="center" alpha="1"/>
        <text id="accuracy"  size="20" color="0xFFFFFFFF" border="0xFF000000" borderSize="1.25" align="left"   alpha="1"/>
        <text id="time"      size="32" color="0xFFFFFFFF" border="0xFF000000" borderSize="2"    align="center" alpha="1"/>
        <text id="rating"    size="64" color="0xFFFFFFFF" border="0xFF000000" borderSize="3"    align="center" alpha="1"/>
        <text id="combo"     size="64" color="0xFFFFFFFF" border="0xFF000000" borderSize="3"    align="center" alpha="1"/>
        <text id="press"     size="22" color="0xFF5CF0DC" border="0xFF000000" borderSize="1.5"  align="center" alpha="1"/>
        <text id="botplay"   size="32" color="0xFFFFFFFF" border="0xFF000000" borderSize="2"    align="center" alpha="1"/>
    </texts>

    <holdAlpha value="0.65"/>

    <shadow enabled="false"/>

    <!-- Splash en imagen aparte (NOTE_splashes.png/xml). Cada lane usa su color: "note impact 1 <color>" (la variante 2 tambien existe). -->
    <splash atlas="splashes/default" scale="1" alpha="0.8" fps="24"/>

    <animations>
        <lane dir="left"  note="purple0" hold="purple hold piece" holdEnd="pruple end hold"  receptor="arrowLEFT"  press="left press"  confirm="left confirm"  splash="note impact 1 purple"/>
        <lane dir="down"  note="blue0"   hold="blue hold piece"   holdEnd="blue hold end"    receptor="arrowDOWN"  press="down press"  confirm="down confirm"  splash="note impact 1 blue"/>
        <lane dir="up"    note="green0"  hold="green hold piece"  holdEnd="green hold end"   receptor="arrowUP"    press="up press"    confirm="up confirm"    splash="note impact 1 green"/>
        <lane dir="right" note="red0"    hold="red hold piece"    holdEnd="red hold end"     receptor="arrowRIGHT" press="right press" confirm="right confirm" splash="note impact 1 red"/>
    </animations>
</hudSkin>
